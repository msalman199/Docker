FROM ubuntu:22.04
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r appuser \
    && useradd -r -g appuser appuser

# Good practice: use non-root user
USER appuser
WORKDIR /home/appuser

# Only expose necessary ports
EXPOSE 8080

CMD ["/bin/bash"]
