# syntax=docker/dockerfile:1

FROM node:18-alpine

WORKDIR /app

# Use bind mount for package.json and install dependencies
RUN --mount=type=bind,source=package.json,target=package.json \
    --mount=type=cache,target=/root/.npm \
    npm install

# Copy application code
COPY . .

EXPOSE 3000
CMD ["npm", "start"]
